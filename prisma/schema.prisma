generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum MockMode {
  STATIC
  STATEFUL
}

enum CredentialType {
  BEARER
  API_KEY
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  projects     Project[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id               String           @id @default(cuid())
  publicId         String           @unique @default(cuid())
  slug             String?          @unique
  name             String
  description      String?
  visibility       Visibility       @default(PRIVATE)
  logRequestBodies Boolean          @default(false)
  ownerId          String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  endpoints        Endpoint[]
  logs             RequestLog[]
  credentials      TestCredential[]

  @@index([ownerId, updatedAt])
  @@index([publicId])
}

model Endpoint {
  id              String             @id @default(cuid())
  projectId       String
  method          HttpMethod
  path            String
  name            String
  description     String?
  statusCode      Int                @default(200)
  responseBody    Json               @default("{}")
  responseHeaders Json               @default("{}")
  requestSchema   Json?
  requestExample  Json?
  responseSchema  Json?
  delayMs         Int                @default(0)
  enabled         Boolean            @default(true)
  visibility      Visibility         @default(PUBLIC)
  mode            MockMode           @default(STATIC)
  seedData        Json?
  stateData       Json?
  authType        CredentialType?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenarios       Scenario[]
  revisions       EndpointRevision[]
  logs            RequestLog[]

  @@unique([projectId, method, path])
  @@index([projectId, method])
}

model Scenario {
  id              String    @id @default(cuid())
  endpointId      String
  name            String
  slug            String
  isDefault       Boolean   @default(false)
  statusCode      Int?
  responseBody    Json?
  responseHeaders Json?
  delayMs         Int?
  mode            MockMode?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  endpoint        Endpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, slug])
}

model EndpointRevision {
  id         String   @id @default(cuid())
  endpointId String
  snapshot   Json
  createdAt  DateTime @default(now())
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
}

model RequestLog {
  id         String    @id @default(cuid())
  projectId  String
  endpointId String?
  method     String
  path       String
  query      Json?
  headers    Json?
  body       Json?
  statusCode Int
  durationMs Int
  scenario   String?
  createdAt  DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpoint   Endpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

model TestCredential {
  id         String         @id @default(cuid())
  projectId  String
  name       String
  type       CredentialType
  secretHash String
  createdAt  DateTime       @default(now())
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
